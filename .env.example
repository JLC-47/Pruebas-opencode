# Copia este archivo a .env y ajusta los valores antes de usar docker compose.
# JWT_SECRET debe ser Base64 de al menos 32 bytes. Este valor es SOLO para desarrollo local.
JWT_SECRET=Y2xhdmUtc3VwZXItc2VndXJhLXBhcmEtZGVzYXJyb2xsby1sb2NhbC0yMDI2LXByb2R1Y3Rvcy1hcGk=

# Base de datos del contenedor
MYSQL_ROOT_PASSWORD=root
DB_USERNAME=productos
DB_PASSWORD=productos123

# Datos de demostracion (solo se crean con SPRING_PROFILES_ACTIVE=dev o test)
APP_SEED_ENABLED=true
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=admin123
APP_SEED_USER_USERNAME=user
APP_SEED_USER_PASSWORD=user123

# JPA_DDL_AUTO=validate exige un esquema previo; update lo crea/actualiza al arrancar.
JPA_DDL_AUTO=update
